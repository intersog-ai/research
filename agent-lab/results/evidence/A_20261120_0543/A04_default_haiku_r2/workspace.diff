+def _parse_iso_duration(raw, original):
+    m = _ISO_DURATION.fullmatch(raw)
+    # Reject bare "P" and "PT" (no components), and "P1DT" (T with no time part).
+    if not m or not any(m.groups()) or raw.upper().endswith("T"):
+        raise ValueError(f"bad duration: {original}")
+    d, h, mi, s = (int(g or 0) for g in m.groups())
+    return d * 86400 + h * 3600 + mi * 60 + s
