+_ISO_DURATION = re.compile(
+    r"P(?:(?P<w>\d+)W|(?:(?P<d>\d+)D)?(?:T(?=\d)(?:(?P<h>\d+)H)?(?:(?P<m>\d+)M)?(?:(?P<s>\d+)S)?)?)",
+    re.IGNORECASE,
+)
+
+
+def _parse_iso_duration(text):
+    m = _ISO_DURATION.fullmatch(text)
+    if not m:
+        raise ValueError(f"bad duration: {text}")
+    if m.group("w") is not None:
+        return int(m.group("w")) * 7 * 86400
+    if not any(m.group(k) for k in "dhms"):
+        raise ValueError(f"bad duration: {text}")
+    d, h, mi, s = (int(m.group(k) or 0) for k in "dhms")
+    return d * 86400 + h * 3600 + mi * 60 + s
+
