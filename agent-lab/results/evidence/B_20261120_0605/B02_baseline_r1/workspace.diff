+@pytest.fixture
+def fake_orders(monkeypatch):
+    from app import service
+    monkeypatch.setattr(
+        service, "get_orders",
+        lambda: [(1, "a", 10), (2, "b", 50), (3, "c", 100)],
+    )
+    return service
+
+
+def test_orders_min_total_none_returns_all(fake_orders):
+    assert len(fake_orders.list_orders()) == 3
+    assert len(fake_orders.list_orders(min_total=None)) == 3
+
+
+def test_orders_min_total_filters(fake_orders):
+    assert [o["id"] for o in fake_orders.list_orders(min_total=50)] == [2, 3]
+
+
+def test_orders_min_total_zero_keeps_all(fake_orders):
+    assert len(fake_orders.list_orders(min_total=0)) == 3
+
+
+def test_orders_min_total_above_all(fake_orders):
+    assert fake_orders.list_orders(min_total=1000) == []
+
+
