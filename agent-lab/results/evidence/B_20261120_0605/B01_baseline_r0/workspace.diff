+    """Parse '1h30m' or ISO 8601 ('PT1H30M', 'PT45S') durations into seconds."""
+    text = text.strip()
+    iso = re.fullmatch(
+        r"P(?:(\d+)D)?(?:T(?:(\d+)H)?(?:(\d+)M)?(?:(\d+)S)?)?", text, re.IGNORECASE
+    )
+    if iso and any(iso.groups()) and not text.upper().endswith("T"):
+        d, h, mi, s = (int(g or 0) for g in iso.groups())
+        return d * 86400 + h * 3600 + mi * 60 + s
+    m = re.fullmatch(r"(?:(\d+)h)?(?:(\d+)m)?(?:(\d+)s)?", text)
