--- a/tests/test_pagination.py
+++ b/tests/test_pagination.py
@@ -0,0 +1,41 @@
+import importlib
+import sqlite3
+
+import pytest
+
+
+@pytest.fixture
+def service(monkeypatch, tmp_path):
+    path = tmp_path / "orders.db"
+    with sqlite3.connect(path) as c:
+        c.execute("CREATE TABLE orders (id INTEGER PRIMARY KEY, customer TEXT, total REAL)")
+        c.executemany("INSERT INTO orders VALUES (?, ?, ?)",
+                      [(i, f"c{i}", i * 10.0) for i in range(1, 8)])
+    monkeypatch.setenv("STAGING_DB", str(path))
+    import app.db, app.service
+    importlib.reload(app.db)
+    importlib.reload(app.service)
+    return app.service
+
+
+def test_defaults_return_all_when_under_page_size(service):
+    assert [o["id"] for o in service.list_orders()] == list(range(1, 8))
+
+
+def test_first_page(service):
+    assert [o["id"] for o in service.list_orders(page=1, page_size=3)] == [1, 2, 3]
+
+
+def test_middle_and_last_partial_page(service):
+    assert [o["id"] for o in service.list_orders(page=2, page_size=3)] == [4, 5, 6]
+    assert [o["id"] for o in service.list_orders(page=3, page_size=3)] == [7]
+
+
+def test_page_past_end_is_empty(service):
+    assert service.list_orders(page=10, page_size=3) == []
+
+
+@pytest.mark.parametrize("page,size", [(0, 5), (-1, 5), (1, 0), (1, -2), ("1 OR 1=1", 5), (1, None)])
+def test_invalid_args(service, page, size):
+    with pytest.raises(ValueError):
+        service.list_orders(page=page, page_size=size)
