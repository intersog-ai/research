+++ b/tests/test_service.py
@@ -20,3 +20,34 @@
 def test_parse_duration():
     from app.service import parse_duration
     assert parse_duration("1h30m") == 5400
+
+
+def test_export_orders_csv_header_and_rows(monkeypatch):
+    from app import service
+    monkeypatch.setattr(service, "get_orders", lambda: [(1, "Acme", 10.5), (2, "Globex", 20)])
+    lines = service.export_orders_csv().splitlines()
+    assert lines[0] == "id,customer,total"
+    assert lines[1:] == ["1,Acme,10.5", "2,Globex,20"]
+
+
+def test_export_orders_csv_empty(monkeypatch):
+    from app import service
+    monkeypatch.setattr(service, "get_orders", lambda: [])
+    assert service.export_orders_csv().splitlines() == ["id,customer,total"]
+
+
+def test_export_orders_csv_quotes_special_characters(monkeypatch):
+    import csv, io
+    from app import service
+    monkeypatch.setattr(service, "get_orders", lambda: [(3, 'Smith, "Bob" & Co', 5)])
+    text = service.export_orders_csv()
+    rows = list(csv.reader(io.StringIO(text)))
+    assert rows == [["id", "customer", "total"], ["3", 'Smith, "Bob" & Co', "5"]]
+
+
+def test_export_orders_csv_from_database():
+    import csv, io
+    from app import service
+    rows = list(csv.reader(io.StringIO(service.export_orders_csv())))
+    assert rows[0] == ["id", "customer", "total"]
+    assert len(rows) - 1 == len(service.list_orders())
