+    """Parse '1h30m' or ISO 8601 ('PT1H30M', 'PT45S', 'P1DT2H') durations into seconds."""
+    text = text.strip()
+    if text[:1] in ("P", "p"):
+        m = _ISO_DURATION.fullmatch(text)
+        # Reject empty ("P") and dangling "T" ("P1DT") forms.
+        if not m or not any(m.groups()) or text.upper().endswith("T"):
+            raise ValueError(f"bad duration: {text}")
+        d, h, mi, s = (int(g or 0) for g in m.groups())
+        return d * 86400 + h * 3600 + mi * 60 + s
