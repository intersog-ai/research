 def test_parse_duration():
     from app.service import parse_duration
     assert parse_duration("1h30m") == 5400
+
+
+def test_parse_duration_iso8601():
+    from app.service import parse_duration
+    assert parse_duration("PT1H30M") == 5400
+    assert parse_duration("PT45S") == 45
+    assert parse_duration("pt2h") == 7200
+    assert parse_duration("PT10M") == 600
+    assert parse_duration("P1DT1H") == 90000
+    assert parse_duration("PT1.5S") == 1
+
+
+def test_parse_duration_iso8601_invalid():
+    import pytest
+    from app.service import parse_duration
+    for bad in ["P", "PT", "P1DT", "PT1H30", "PT-5S", "PTS"]:
+        with pytest.raises(ValueError):
+            parse_duration(bad)
