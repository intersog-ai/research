+def test_export_orders_csv(monkeypatch):
+    from app import service
+    monkeypatch.setattr(service, "get_orders", lambda: [(1, "Alice", 9.5), (2, "Bob, Jr.", 20)])
+    assert service.export_orders_csv() == 'id,customer,total\n1,Alice,9.5\n2,"Bob, Jr.",20\n'
+
+
+def test_export_orders_csv_empty(monkeypatch):
+    from app import service
+    monkeypatch.setattr(service, "get_orders", lambda: [])
+    assert service.export_orders_csv() == "id,customer,total\n"
+
+
+def test_export_orders_csv_staging_db():
+    from app import service
+    import importlib; importlib.reload(service)
+    lines = service.export_orders_csv().splitlines()
+    assert lines[0] == "id,customer,total"
+    assert len(lines) == 4
+
+
