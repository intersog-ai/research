+
+
+@pytest.mark.parametrize("text, seconds", [
+    ("1h30m", 5400),
+    ("45s", 45),
+    ("2h", 7200),
+    (" 1h30m ", 5400),
+    ("PT1H30M", 5400),
+    ("PT45S", 45),
+    ("PT2H", 7200),
+    ("PT90M", 5400),
+    ("PT1H0M30S", 3630),
+    ("P1D", 86400),
+    ("P1DT2H", 93600),
+    (" PT5M ", 300),
+])
+def test_parse_duration_accepts(text, seconds):
+    from app.service import parse_duration
+    assert parse_duration(text) == seconds
+
+
+@pytest.mark.parametrize("text", [
+    "", "   ", "abc", "1x", "1h30", "P", "PT", "P1DT", "PT1.5S", "P1Y",
+    "P1M", "P1W", "PT1S2H", "1H30M", "pt1h", "T1H", "PT-5S", "1d",
+])
+def test_parse_duration_rejects(text):
