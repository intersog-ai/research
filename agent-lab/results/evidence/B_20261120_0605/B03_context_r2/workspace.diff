+import csv
+import io
 import re
 from app.db import get_orders
 
 
 def list_orders():
     return [{"id": i, "customer": c, "total": t} for i, c, t in get_orders()]
+
+
+def export_orders_csv():
+    """Return all orders as CSV text with header id,customer,total."""
+    buf = io.StringIO()
+    writer = csv.writer(buf, lineterminator="\n")
+    writer.writerow(["id", "customer", "total"])
+    writer.writerows(get_orders())
+    return buf.getvalue()
 
 
