+@pytest.fixture
+def five_orders(tmp_path, monkeypatch):
+    path = tmp_path / "orders.db"
+    c = sqlite3.connect(path)
+    c.execute("CREATE TABLE orders(id INTEGER PRIMARY KEY, customer TEXT, total REAL)")
+    c.executemany(
+        "INSERT INTO orders(customer, total) VALUES (?, ?)",
+        [(f"cust{i}", float(i)) for i in range(1, 6)],
+    )
+    c.commit()
+    c.close()
+    import app.db
+    monkeypatch.setattr(app.db, "DB_PATH", str(path))
+    from app import service
+    return service
+
+
+def test_list_orders_default_page_returns_all_when_small(five_orders):
+    assert [o["id"] for o in five_orders.list_orders()] == [1, 2, 3, 4, 5]
+
+
+def test_list_orders_pages(five_orders):
+    ids = lambda **kw: [o["id"] for o in five_orders.list_orders(**kw)]
+    assert ids(page=1, page_size=2) == [1, 2]
+    assert ids(page=2, page_size=2) == [3, 4]
+    assert ids(page=3, page_size=2) == [5]
+
+
+def test_list_orders_past_end_is_empty(five_orders):
+    assert five_orders.list_orders(page=4, page_size=2) == []
+
+
+def test_list_orders_default_page_size_is_50(five_orders):
+    assert len(five_orders.list_orders(page=1)) == 5
+
+
+def test_list_orders_row_shape(five_orders):
+    assert five_orders.list_orders(page=2, page_size=1) == [
+        {"id": 2, "customer": "cust2", "total": 2.0}
+    ]
+
+
+@pytest.mark.parametrize("kwargs", [{"page": 0}, {"page": -1}, {"page_size": 0}])
+def test_list_orders_rejects_invalid_args(five_orders, kwargs):
+    with pytest.raises(ValueError):
+        five_orders.list_orders(**kwargs)
+
+
+def test_list_orders_uses_bound_parameters(five_orders, monkeypatch):
+    import app.db
+    seen = {}
+    real = app.db.connect
+
+    class Spy:
+        def __init__(self, conn):
+            self._conn = conn
+
+        def __enter__(self):
+            return self
+
+        def __exit__(self, *exc):
+            return self._conn.__exit__(*exc)
+
+        def execute(self, sql, params=()):
+            seen["sql"], seen["params"] = sql, params
+            return self._conn.execute(sql, params)
+
+    monkeypatch.setattr(app.db, "connect", lambda: Spy(real()))
+    five_orders.list_orders(page=2, page_size=2)
+    assert "LIMIT ? OFFSET ?" in seen["sql"]
+    assert seen["params"] == (2, 2)
