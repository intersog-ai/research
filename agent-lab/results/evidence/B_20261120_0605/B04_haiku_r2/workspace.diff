+@pytest.fixture
+def paged_service(tmp_path, monkeypatch):
+    import importlib, sqlite3
+    from app import db, service
+    path = tmp_path / "orders.db"
+    with sqlite3.connect(path) as c:
+        c.execute("CREATE TABLE orders(id INTEGER PRIMARY KEY, customer TEXT, total REAL)")
+        c.executemany(
+            "INSERT INTO orders(customer, total) VALUES (?, ?)",
+            [(f"cust{i}", float(i)) for i in range(1, 6)],
+        )
+    monkeypatch.setenv("STAGING_DB", str(path))
+    importlib.reload(db)
+    importlib.reload(service)
+    yield service
+
+
+def test_list_orders_defaults_return_all_when_small(paged_service):
+    rows = paged_service.list_orders()
+    assert [r["id"] for r in rows] == [1, 2, 3, 4, 5]
+
+
+def test_list_orders_page_size_limits_rows(paged_service):
+    rows = paged_service.list_orders(page=1, page_size=2)
+    assert [r["id"] for r in rows] == [1, 2]
+
+
+def test_list_orders_pages_are_consecutive(paged_service):
+    assert [r["id"] for r in paged_service.list_orders(2, 2)] == [3, 4]
+    assert [r["id"] for r in paged_service.list_orders(3, 2)] == [5]
+
+
+def test_list_orders_page_past_end_is_empty(paged_service):
+    assert paged_service.list_orders(page=10, page_size=2) == []
+
+
+def test_list_orders_row_shape(paged_service):
+    row = paged_service.list_orders(page=1, page_size=1)[0]
+    assert row == {"id": 1, "customer": "cust1", "total": 1.0}
+
+
+@pytest.mark.parametrize("page,page_size", [(0, 50), (-1, 50), (1, 0), (1, -5)])
+def test_list_orders_rejects_invalid_arguments(paged_service, page, page_size):
+    with pytest.raises(ValueError):
+        paged_service.list_orders(page=page, page_size=page_size)
