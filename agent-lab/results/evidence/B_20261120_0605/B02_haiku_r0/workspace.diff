+def test_list_orders_no_filter_returns_all():
+    from app import service
+    import importlib; importlib.reload(service)
+    assert [o["id"] for o in service.list_orders()] == [1, 2, 3]
+    assert [o["id"] for o in service.list_orders(min_total=None)] == [1, 2, 3]
+
+
+def test_list_orders_min_total_filters():
+    from app import service
+    import importlib; importlib.reload(service)
+    orders = service.list_orders(min_total=100)
+    assert [o["id"] for o in orders] == [1, 3]
+    assert all(o["total"] >= 100 for o in orders)
+
+
+def test_list_orders_min_total_is_inclusive():
+    from app import service
+    import importlib; importlib.reload(service)
+    assert [o["id"] for o in service.list_orders(min_total=120.0)] == [1, 3]
+
+
+def test_list_orders_min_total_above_all_returns_empty():
+    from app import service
+    import importlib; importlib.reload(service)
+    assert service.list_orders(min_total=1000) == []
+
