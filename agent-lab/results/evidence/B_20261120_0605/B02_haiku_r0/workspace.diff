+def list_orders(min_total=None):
+    """Return orders as dicts. If min_total is given, keep only orders with total >= min_total."""
+    orders = [{"id": i, "customer": c, "total": t} for i, c, t in get_orders()]
+    if min_total is not None:
+        orders = [o for o in orders if o["total"] >= min_total]
+    return orders
 
 
