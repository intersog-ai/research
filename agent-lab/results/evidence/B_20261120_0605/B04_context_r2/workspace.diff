-    return [{"id": i, "customer": c, "total": t} for i, c, t in get_orders()]
+def list_orders(page=1, page_size=50):
+    if not isinstance(page, int) or not isinstance(page_size, int) or page < 1 or page_size < 1:
+        raise ValueError("page and page_size must be integers >= 1")
+    rows = get_orders(limit=page_size, offset=(page - 1) * page_size)
+    return [{"id": i, "customer": c, "total": t} for i, c, t in rows]
 
 
