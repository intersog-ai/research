 def parse_duration(text):
-    """Parse '1h30m' style durations into seconds."""
+    """Parse '1h30m' or ISO 8601 ('PT1H30M', 'P1DT2H', 'PT0.5S') durations into seconds."""
+    text = text.strip()
+    iso = re.fullmatch(
+        r"P(?:(\d+)D)?(?:T(?:(\d+)H)?(?:(\d+)M)?(?:(\d+(?:\.\d+)?)S)?)?",
+        text,
+        re.IGNORECASE,
+    )
+    if iso:
+        d, h, mi, s = iso.groups()
+        if not any((d, h, mi, s)) or text.upper().endswith("T"):
+            raise ValueError(f"bad duration: {text}")
+        total = int(d or 0) * 86400 + int(h or 0) * 3600 + int(mi or 0) * 60 + float(s or 0)
+        return int(total) if total == int(total) else total
     m = re.fullmatch(r"(?:(\d+)h)?(?:(\d+)m)?(?:(\d+)s)?", text.strip())
     if not m or not any(m.groups()):
         raise ValueError(f"bad duration: {text}")
