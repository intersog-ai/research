+    """Parse '1h30m' or ISO 8601 ('PT1H30M', 'P1DT2H') durations into seconds."""
+    text = text.strip()
+    iso = re.fullmatch(
+        r"P(?:(\d+)D)?(?:T(?:(\d+)H)?(?:(\d+)M)?(?:(\d+)S)?)?", text, re.IGNORECASE
+    )
+    if iso:
+        if not any(iso.groups()) or text.upper().endswith("T"):
+            raise ValueError(f"bad duration: {text}")
+        d, h, mi, s = (int(g or 0) for g in iso.groups())
+        return d * 86400 + h * 3600 + mi * 60 + s
+    m = re.fullmatch(r"(?:(\d+)h)?(?:(\d+)m)?(?:(\d+)s)?", text)
