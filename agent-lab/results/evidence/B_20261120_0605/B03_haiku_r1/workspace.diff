+def test_export_orders_csv_header_and_rows():
+    from app.service import export_orders_csv
+    lines = export_orders_csv().splitlines()
+    assert lines[0] == "id,customer,total"
+    assert lines[1:] == ["1,acme,120.0", "2,globex,75.5", "3,initech,310.0"]
+
+
+def test_export_orders_csv_quotes_special_characters(monkeypatch):
+    import app.service as service
+    monkeypatch.setattr(service, "get_orders", lambda: [(7, 'Smith, "Co"', 9.0)])
+    import csv, io
+    rows = list(csv.reader(io.StringIO(service.export_orders_csv())))
+    assert rows == [["id", "customer", "total"], ["7", 'Smith, "Co"', "9.0"]]
+
+
+def test_export_orders_csv_empty(monkeypatch):
+    import app.service as service
+    monkeypatch.setattr(service, "get_orders", lambda: [])
+    assert service.export_orders_csv() == "id,customer,total\n"
+
