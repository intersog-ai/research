+_ISO_DURATION = re.compile(
+    r"P(?:(\d+)D)?(?:T(?:(\d+)H)?(?:(\d+)M)?(?:(\d+(?:\.\d+)?)S)?)?"
+)
+
+
+def _parse_iso_duration(text):
+    m = _ISO_DURATION.fullmatch(text)
+    # Need at least one component, and a "T" must be followed by one.
+    if not m or not any(m.groups()) or (text.endswith("T")):
+        raise ValueError(f"bad duration: {text}")
+    d, h, mi, s = m.groups()
+    total = int(d or 0) * 86400 + int(h or 0) * 3600 + int(mi or 0) * 60
+    secs = float(s) if s and "." in s else int(s or 0)
+    return total + secs
+
+
