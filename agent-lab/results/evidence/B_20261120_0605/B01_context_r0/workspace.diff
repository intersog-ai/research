 def test_parse_duration():
     from app.service import parse_duration
     assert parse_duration("1h30m") == 5400
+
+
+def test_parse_duration_iso():
+    from app.service import parse_duration
+    assert parse_duration("PT1H30M") == 5400
+    assert parse_duration("PT45S") == 45
+    assert parse_duration("PT2H") == 7200
+    assert parse_duration("PT10M") == 600
+    assert parse_duration("P1DT2H") == 93600
+    assert parse_duration("P2D") == 172800
+    assert parse_duration("PT1.5S") == 1.5
+    assert parse_duration(" pt1h ") == 3600
+
+
+@pytest.mark.parametrize("bad", ["P", "PT", "P1DT", "PT1H30", "PT1S1M", "xyz", ""])
+def test_parse_duration_invalid(bad):
+    from app.service import parse_duration
+    with pytest.raises(ValueError):
+        parse_duration(bad)
