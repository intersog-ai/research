+++ b/tests/test_service.py
@@ -20,3 +20,35 @@
 def test_parse_duration():
     from app.service import parse_duration
     assert parse_duration("1h30m") == 5400
+
+
+@pytest.fixture
+def many_orders(tmp_path, monkeypatch):
+    path = tmp_path / "orders.db"
+    con = sqlite3.connect(path)
+    con.execute("CREATE TABLE orders (id INTEGER PRIMARY KEY, customer TEXT, total REAL)")
+    con.executemany("INSERT INTO orders VALUES (?, ?, ?)", [(n, f"c{n}", n * 1.5) for n in range(1, 8)])
+    con.commit()
+    con.close()
+    import app.db
+    monkeypatch.setattr(app.db, "DB_PATH", str(path))
+    from app import service
+    return service
+
+
+def test_pagination_pages(many_orders):
+    assert [o["id"] for o in many_orders.list_orders(page=1, page_size=3)] == [1, 2, 3]
+    assert [o["id"] for o in many_orders.list_orders(page=2, page_size=3)] == [4, 5, 6]
+    assert [o["id"] for o in many_orders.list_orders(page=3, page_size=3)] == [7]
+
+
+def test_pagination_defaults_and_out_of_range(many_orders):
+    assert len(many_orders.list_orders()) == 7
+    assert many_orders.list_orders(page=99) == []
+
+
+def test_pagination_invalid_args(many_orders):
+    with pytest.raises(ValueError):
+        many_orders.list_orders(page=0)
+    with pytest.raises(ValueError):
+        many_orders.list_orders(page_size=0)
