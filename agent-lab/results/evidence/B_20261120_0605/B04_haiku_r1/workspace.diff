+def list_orders(page=1, page_size=50):
+    """Return one page of orders (1-based page numbers)."""
+    if not isinstance(page, int) or isinstance(page, bool) or page < 1:
+        raise ValueError(f"page must be an integer >= 1: {page!r}")
+    if not isinstance(page_size, int) or isinstance(page_size, bool) or page_size < 1:
+        raise ValueError(f"page_size must be an integer >= 1: {page_size!r}")
+    offset = (page - 1) * page_size
+    rows = get_orders(page_size, offset)
+    return [{"id": i, "customer": c, "total": t} for i, c, t in rows]
 
 
