+@pytest.fixture
+def many_orders(tmp_path, monkeypatch):
+    path = str(tmp_path / "orders.db")
+    with sqlite3.connect(path) as c:
+        c.execute("CREATE TABLE orders (id INTEGER PRIMARY KEY, customer TEXT, total REAL)")
+        c.executemany("INSERT INTO orders VALUES (?, ?, ?)",
+                      [(i, f"c{i}", i * 1.5) for i in range(1, 126)])
+    import app.db
+    monkeypatch.setattr(app.db, "DB_PATH", path)
+
+
+def test_list_orders_defaults(many_orders):
+    from app import service
+    res = service.list_orders()
+    assert len(res) == 50
+    assert res[0] == {"id": 1, "customer": "c1", "total": 1.5}
+    assert res[-1]["id"] == 50
+
+
+def test_list_orders_page_and_size(many_orders):
+    from app import service
+    assert [o["id"] for o in service.list_orders(page=2, page_size=10)] == list(range(11, 21))
+
+
+def test_list_orders_last_partial_and_beyond(many_orders):
+    from app import service
+    assert len(service.list_orders(page=3)) == 25
+    assert service.list_orders(page=4) == []
