+++ b/tests/test_service.py
@@ -17,6 +17,36 @@
     assert len(service.list_orders()) == 3
 
 
+@pytest.fixture
+def fake_orders(monkeypatch):
+    from app import service
+    rows = [(1, "acme", 120.0), (2, "globex", 75.5), (3, "initech", 310.0)]
+    monkeypatch.setattr(service, "get_orders", lambda: rows)
+    return service
+
+
+def test_list_orders_without_min_total_returns_all(fake_orders):
+    assert [o["id"] for o in fake_orders.list_orders()] == [1, 2, 3]
+
+
+def test_list_orders_min_total_filters(fake_orders):
+    result = fake_orders.list_orders(min_total=100)
+    assert [o["id"] for o in result] == [1, 3]
+    assert all(o["total"] >= 100 for o in result)
+
+
+def test_list_orders_min_total_is_inclusive(fake_orders):
+    assert [o["id"] for o in fake_orders.list_orders(min_total=120.0)] == [1, 3]
+
+
+def test_list_orders_min_total_above_all_returns_empty(fake_orders):
+    assert fake_orders.list_orders(min_total=1000) == []
+
+
+def test_list_orders_min_total_zero_returns_all(fake_orders):
+    assert len(fake_orders.list_orders(min_total=0)) == 3
+
+
