+def _check_positive_int(name, value):
+    if not isinstance(value, int) or isinstance(value, bool) or value < 1:
+        raise ValueError(f"{name} must be an integer >= 1: {value!r}")
+
+
+def list_orders(page=1, page_size=50):
+    _check_positive_int("page", page)
+    _check_positive_int("page_size", page_size)
+    rows = get_orders_page(page_size, (page - 1) * page_size)
+    return [{"id": i, "customer": c, "total": t} for i, c, t in rows]
 
 
