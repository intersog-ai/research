+@pytest.fixture
+def temp_orders_db(tmp_path, monkeypatch):
+    path = str(tmp_path / "orders.db")
+    conn = sqlite3.connect(path)
+    conn.execute("CREATE TABLE orders (id INTEGER PRIMARY KEY, customer TEXT, total REAL)")
+    conn.executemany("INSERT INTO orders VALUES (?, ?, ?)", [(i, f"c{i}", i * 10.0) for i in range(1, 8)])
+    conn.commit()
+    conn.close()
+    monkeypatch.setenv("STAGING_DB", path)
+    import importlib, app.db, app.service
+    importlib.reload(app.db)
+    importlib.reload(app.service)
+    return app.service
+
+
+def test_pagination_defaults(temp_orders_db):
+    assert [o["id"] for o in temp_orders_db.list_orders()] == list(range(1, 8))
+
+
+def test_pagination_pages(temp_orders_db):
+    s = temp_orders_db
+    assert [o["id"] for o in s.list_orders(page=1, page_size=3)] == [1, 2, 3]
+    assert [o["id"] for o in s.list_orders(page=2, page_size=3)] == [4, 5, 6]
+    assert [o["id"] for o in s.list_orders(page=3, page_size=3)] == [7]
+    assert s.list_orders(page=4, page_size=3) == []
+
+
+def test_pagination_row_shape(temp_orders_db):
+    assert temp_orders_db.list_orders(page=2, page_size=6) == [{"id": 7, "customer": "c7", "total": 70.0}]
+
+
+@pytest.mark.parametrize("kwargs", [
+    {"page": 0}, {"page": -1}, {"page_size": 0}, {"page_size": -5},
+    {"page": "1 OR 1=1"}, {"page_size": "5"}, {"page": 1.5},
+])
+def test_pagination_rejects_bad_args(temp_orders_db, kwargs):
+    with pytest.raises(ValueError):
+        temp_orders_db.list_orders(**kwargs)
+
+
